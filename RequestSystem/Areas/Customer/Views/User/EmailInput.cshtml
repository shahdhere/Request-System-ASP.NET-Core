@using RequestSystem.Areas.Customer.ViewModels
@model EmailInputViewModel
<div class="container mt-5 d-flex justify-content-center">
    <div style="width: 1260px; border: 2px solid #ccc; padding: 20px;
                border-radius: 10px; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">

     <div style="background-color: #19692c; padding: 15px; border-top-left-radius: 10px; border-top-right-radius: 10px;
         display: flex; align-items: center; justify-content: flex-start; ">
            <i class="bi bi-person-check-fill" style="color: white; font-size: 30px;"></i>
              <h3 style="color: white; margin: 0; margin-right: 10px;">
              تسجيل الدخول
              </h3>
     </div>

        <form asp-action="SendOtp" method="post">
        <div class="mb-3">
                <label style="margin-bottom: 8px; display: block;">البريد الإلكتروني <span style="color: red;">*</span></label>
                <input asp-for="Email" class="form-control"
                   style="width: 100%; height: 50px; font-size: 16px; padding: 10px;" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <button type="submit" class="btn"
                style="width: 100%; height: 50px; margin-top: 10px;
               background-color: white;
               color: #19692c;
               border: 2px solid #19692c;
               font-weight: bold;">
            التالي
        </button>
    </form>
</div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
